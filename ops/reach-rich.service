[Unit]
Description=REACH RICH Next.js application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=reach-rich
Group=reach-rich
WorkingDirectory=/opt/reach-rich/current
EnvironmentFile=/etc/reach-rich/production.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3106
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/local/bin/node --max-old-space-size=512 server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027
MemoryHigh=640M
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
