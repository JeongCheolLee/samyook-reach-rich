FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG APP_URL=https://36-reach-rich.jeongcheol.cloud
ENV APP_URL=$APP_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build
RUN cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static
RUN mkdir -p .next/standalone/db && cp -r db/migrations .next/standalone/db/migrations
RUN npx esbuild scripts/migrate.ts scripts/redis-import.ts scripts/redis-verify.ts --bundle --platform=node --format=cjs --packages=external --outdir=.next/standalone/ops --out-extension:.js=.cjs

FROM scratch AS artifact
COPY --from=builder /app/.next/standalone/ /
